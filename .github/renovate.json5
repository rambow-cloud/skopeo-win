{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "custom.regex"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": [
    "before 6am on monday"
  ],
  "dependencyDashboard": {
    "enabled": true,
    "title": "Dependency Dashboard"
  },
  "automerge": false,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "ignorePaths": [
    "**/vendor/**",
    "**/.cache/**",
    "**/testdata/**"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Keep compatible Go module updates together across both modules",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require",
        "indirect"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Go dependencies"
    },
    {
      "description": "Keep production and integration Go versions aligned",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "rangeStrategy": "bump",
      "groupName": "Go toolchain"
    },
    {
      "description": "Preserve reviewed Windows vendor behavior and exact Go notice provenance",
      "matchManagers": [
        "gomod"
      ],
      "prBodyNotes": [
        "Reviewed image/common source forks already include the Windows archive fix. Do not remove their pinned replacements or apply the old patch twice; update packaging/store/module-sources.json and its exact source digests only after reviewing the new source commits.",
        "Go version updates must include the exact official LICENSE/PATENTS snapshot under packaging/store/go-notices/<goVersion> and pass Store package verification."
      ]
    },
    {
      "description": "Keep GitHub Actions pinned to immutable commit digests",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "pinDigests": true
    },
    {
      "description": "Require dashboard approval before major upgrades",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Coordinate reviewed library baselines and source fork versions",
      "matchDepNames": [
        "go.podman.io/common",
        "go.podman.io/image/v5",
        "github.com/rambow-cloud/container-libs/common",
        "github.com/rambow-cloud/container-libs/image/v5"
      ],
      "groupName": "Reviewed container libraries",
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/windows\\.yml$/"
      ],
      "matchStrings": [
        "go install (?<depName>golang\\.org/x/vuln)/cmd/govulncheck@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": "0 days",
    "dependencyDashboardApproval": false,
    "groupName": null
  }
}
